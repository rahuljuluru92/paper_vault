{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "paper-vault",
  "post": {
    "dir": "public",
    "entrypoints": {
      "default": {
        "entry": "splash.html",
        "height": "tall"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {},
  "permissions": {
    "redis": true,
    "journeys": true,
    "reddit": {
      "enable": true,
      "scope": "user",
      "asUser": [
        "SUBMIT_COMMENT"
      ]
    }
  },
  "menu": {
    "items": [
      {
        "label": "Paper Vault: post today's vault",
        "description": "Creates today's vault post if it is not up yet.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/new-post"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/on/app/install",
    "onAppUpgrade": "/internal/on/app/upgrade",
    "onPostDelete": "/internal/on/post/delete",
    "onCommentDelete": "/internal/on/comment/delete"
  },
  "scheduler": {
    "tasks": {
      "daily": {
        "endpoint": "/internal/cron/daily",
        "cron": "5 0 * * *"
      }
    }
  },
  "scripts": {
    "dev": "npm run watch"
  }
}